# Hermes backend configuration — copy to backend/.env and fill in.
# Every variable the code reads is listed here; the value shown is the
# code's built-in default unless noted.

# --- Core services (match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://hermes:hermes_pass@localhost:5432/hermes_db
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                       # only needed for Qdrant Cloud
# OLLAMA_EMBED_TIMEOUT=120
# OLLAMA_EMBED_MODEL=nomic-embed-text   # only when EMBED_MODEL is ollama/nomic
# CUDA_VISIBLE_DEVICES=0                   # set to select a GPU for BGE

# --- LLM / embeddings ---
# Generation goes through LiteLLM. Three ways to select a provider:
#   ollama      -> local Ollama server, needs a pulled model, no API key
#   openrouter  -> OpenRouter hosted models, needs OPENROUTER_API_KEY
#   anything else (e.g. "groq") -> Groq-hosted models, needs GROQ_API_KEY
LLM_PROVIDER=ollama
OLLAMA_API_BASE=http://localhost:11434

# Groq-hosted tiers (used when LLM_PROVIDER is not "ollama"/"openrouter", and
# as litellm fallbacks otherwise). Override any tier without a code change.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL_SIMPLE=groq/openai/gpt-oss-20b
# GROQ_MODEL_COMPLEX=groq/openai/gpt-oss-120b
# GROQ_MODEL_LONG_DOC=groq/openai/gpt-oss-120b
# GROQ_MODEL_CLASSIFY=groq/openai/gpt-oss-20b
# GROQ_MODEL_OFFLINE=groq/openai/gpt-oss-20b

# OpenRouter tiers (set LLM_PROVIDER=openrouter).
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL_SIMPLE=openrouter/meta-llama/llama-3.2-3b-instruct
# OPENROUTER_MODEL_CLASSIFY=openrouter/meta-llama/llama-3.2-3b-instruct
# OPENROUTER_MODEL_COMPLEX=openrouter/google/gemini-2.5-flash-lite

# The "offline" tier is meant to stay on your machine. It only uses Ollama when
# OLLAMA_API_BASE is set; otherwise it falls back to the hosted Groq default.
# OLLAMA_MODEL_OFFLINE=ollama/llama3.1:8b
# GEMINI_API_KEY=

# Embeddings and reranking are LOCAL by default — no API key required.
# EMBED_MODEL accepts a name from the DIMENSIONS table: bge-m3 (1024-dim,
# default) | ollama / nomic (768-dim, needs the Ollama server).
# Do NOT set the full HF id "BAAI/bge-m3" here: it misses the table and the
# BGE code path, and is silently treated as an Ollama model name.
# EMBED_MODEL=bge-m3
# VECTOR_DIM=768                         # fallback dim for models not in the table
# EMBED_DEVICE=cuda                      # default: cuda if CUDA_VISIBLE_DEVICES else cpu
# EMBED_BATCH_SIZE=32
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_DEVICE=                         # empty = let sentence-transformers decide
# Route simple queries to the complex model:
# HERMES_SIMPLE_MODEL=complex

# --- Auth ---
# REQUIRED in production. Must be a long random string; startup fails if left
# as the default while ENV=production.
SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
ENV=development
# Registration enforces a password length of 8-128 characters.

# --- MCP ---
# REQUIRED. stdio MCP carries no request-level identity, so hermes_search and
# hermes_research run under this user's ACL. If unset, both tools return an
# error instead of running unscoped.
# HERMES_MCP_USER_ID=1

# --- Retrieval tuning ---
RETRIEVAL_CANDIDATES=50
MIN_RERANK_SCORE=0.0
GRADE_SCORE_THRESHOLD=0.25
HERMES_MULTI_QUERY=1
HERMES_CRAG_LITE=0
HERMES_GRAPH_RAG=0
HERMES_GRAPH_FAST=1
CONTEXT_PACK_TOP_K=5
CHUNK_STRATEGY=fixed_large
# PARENT_CHUNK_SIZE=1000
# PARENT_CHUNK_OVERLAP=100
# CHILD_CHUNK_SIZE=200
# CHILD_CHUNK_OVERLAP=40

# --- Multi-turn memory (HE-2) ---
HERMES_MULTI_TURN=1
HERMES_MEMORY_TURNS=4
HERMES_MULTI_QUERY_COUNT=2

# --- Workspace ACL (HE-4) ---
# Points ingested before per-user ACLs existed carry no user_id and are
# invisible while filtering. Re-ingest those documents after upgrading.

# --- Tools (HE-7) ---
# Comma-separated host suffixes for optional web_fetch; empty disables.
HERMES_WEB_ALLOWLIST=

# --- Evaluation ---
# Comma-separated allow-list of emails permitted to trigger POST /api/eval/run.
# If this is unset or empty the allow-list is empty and EVERY run is denied (403).
# Set it to enable eval runs at all.
# EVAL_ADMIN_EMAILS=you@example.com
# Judge model override for RAGAS (openrouter/... or an ollama model name).
# HERMES_RAGAS_JUDGE=openrouter/google/gemini-2.5-flash-lite
# RAGAS_MAX_WORKERS=16
# RAGAS_BUILD_WORKERS=8
# RAGAS_MAX_RETRIES=3
# RAGAS_TIMEOUT=600

# --- Tests ---
# The pytest suite refuses to run against the hermes_db database above because
# it truncates tables between tests. Point this at a throwaway database.
# DATABASE_URL=postgresql+asyncpg://hermes:hermes_pass@localhost:5432/hermes_test